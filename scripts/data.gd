const CHAPTERS = [
	{"kanji": "羅生門", "name": "Rashōmon", "from": 0, "note": "Rashōmon was the great southern gate of Heian-kyō, today's Kyoto. By the late tenth century it stood in ruins, and legend says the warrior Watanabe no Tsuna cut off an oni's arm there.", "haiku": ["夏草や兵どもが夢の跡", "natsukusa ya / tsuwamono-domo ga / yume no ato", "Summer grasses: all that is left of the warriors' dreams.", "Bashō"]},
	{"kanji": "鞍馬山", "name": "Kurama", "from": 10, "note": "Mount Kurama rises north of Kyoto. The boy Ushiwakamaru, later the general Minamoto no Yoshitsune, is said to have learned the sword there from Sōjōbō, king of the tengu.", "haiku": ["山路来て何やらゆかしすみれ草", "yamaji kite / naniyara yukashi / sumiregusa", "Coming along a mountain path, something strangely dear: a wild violet.", "Bashō"]},
	{"kanji": "信太の森", "name": "Shinoda", "from": 20, "note": "Shinoda is a forest in old Izumi province. In legend the white fox Kuzunoha lived there, and her son became Abe no Seimei (921–1005), the great diviner of the Heian court.", "haiku": ["公達に狐化けたり宵の春", "kindachi ni / kitsune baketari / yoi no haru", "A fox has turned itself into a young nobleman: an evening in spring.", "Buson"]},
	{"kanji": "大江山", "name": "Mount Ōe", "from": 30, "note": "Mount Ōe was the stronghold of the oni king Shuten-dōji, who in legend was slain by Minamoto no Raikō and his four retainers, Watanabe no Tsuna among them, after they drugged his wine.", "haiku": ["月花もなくて酒のむ独り哉", "tsuki hana mo / nakute sake nomu / hitori kana", "With neither moon nor blossoms, a man drinks sake all alone.", "Bashō"]},
	{"kanji": "那須野", "name": "Nasu", "from": 40, "note": "On Nasu moor stands the Sesshō-seki, the Killing Stone, said to be the body of the nine-tailed fox Tamamo-no-Mae. Tradition says the monk Gennō split it in 1385.", "haiku": ["野を横に馬牽むけよほととぎす", "no o yoko ni / uma hikimuke yo / hototogisu", "Turn the horse sideways across the moor: a cuckoo is calling.", "Bashō"]},
	{"kanji": "雪国", "name": "Snow Country", "from": 50, "note": "The snow country lies along the Japan Sea, buried each winter. There the Yuki-onna, the snow woman, is said to appear to travellers lost in blizzards.", "haiku": ["これがまあつひの栖か雪五尺", "kore ga mā / tsui no sumika ka / yuki goshaku", "So this, then, is my last dwelling place? Five feet of snow.", "Issa"]},
	{"kanji": "河童淵", "name": "Kappa Pool", "from": 60, "note": "Kappa-buchi is a stream at Tōno in the north, long said to be full of kappa. They love cucumbers and sumo, and lose their strength if the water in the dish on their head is spilled.", "haiku": ["古池や蛙飛びこむ水の音", "furuike ya / kawazu tobikomu / mizu no oto", "An old pond: a frog jumps in, the sound of water.", "Bashō"]},
	{"kanji": "化野", "name": "Adashino", "from": 70, "note": "Adashino, west of Kyoto, was a burial ground where the dead were once left in the open. Some eight thousand stone markers for the unmourned now stand at Adashino Nenbutsu-ji.", "haiku": ["露の世は露の世ながらさりながら", "tsuyu no yo wa / tsuyu no yo nagara / sarinagara", "This world of dew is a world of dew, and yet, and yet.", "Issa"]},
	{"kanji": "恐山", "name": "Mount Osore", "from": 80, "note": "Osore-zan, in the far north, is one of Japan's three great sacred mountains: a sulphurous caldera held to be an entrance to the afterlife, with its own Sanzu River to cross.", "haiku": ["閑さや岩にしみ入る蝉の声", "shizukasa ya / iwa ni shimiiru / semi no koe", "Such stillness: the cicadas' cries sink into the rocks.", "Bashō"]},
	{"kanji": "百鬼夜行", "name": "Night Parade", "from": 90, "note": "Hyakki Yagyō, the night parade of a hundred demons, was dreaded in Heian Kyoto. On the nights it was expected, the nobility stayed indoors rather than meet it.", "haiku": ["化けさうな傘かす寺の時雨かな", "bakesō na / kasa kasu tera no / shigure kana", "The temple lends me an umbrella that looks ready to turn goblin: winter rain.", "Buson"]},
	{"kanji": "禅寺", "name": "Zen Temple", "from": 100, "note": "Zen took root in Japan in the 12th and 13th centuries with the monks Eisai and Dōgen. A kōan is a question set by a teacher that reasoning alone cannot answer.", "haiku": ["盗人にとり残されし窓の月", "nusubito ni / torinokosareshi / mado no tsuki", "Left behind by the thief: the moon in the window.", "Ryōkan"]},
	{"kanji": "石庭", "name": "Stone Garden", "from": 118, "note": "The dry garden, karesansui, uses raked gravel for water and stones for mountains. The most famous, at Ryōan-ji in Kyoto, has fifteen stones laid so that one is always hidden from view.", "haiku": ["石山の石より白し秋の風", "ishiyama no / ishi yori shiroshi / aki no kaze", "Whiter than the stones of the stone mountain: the autumn wind.", "Bashō"]},
	{"kanji": "鳥居", "name": "The Gate", "from": 136, "note": "A torii marks the boundary between the everyday world and sacred ground at a Shinto shrine. At Fushimi Inari in Kyoto, thousands of vermilion gates line the mountain path.", "haiku": ["この道や行く人なしに秋の暮", "kono michi ya / yuku hito nashi ni / aki no kure", "This road: no one travels along it, as the autumn evening falls.", "Bashō"]},
	{"kanji": "墨染", "name": "Wet Ink", "from": 154, "note": "Ink painting came to Japan with Zen. Its masters, among them Sesshū (1420–1506), whose Long Scroll hangs above this road, prized the stroke that cannot be corrected.", "haiku": ["初しぐれ猿も小蓑をほしげ也", "hatsushigure / saru mo komino o / hoshige nari", "First winter shower: even the monkey seems to want a little straw raincoat.", "Bashō"]},
	{"kanji": "円相", "name": "Ensō", "from": 172, "note": "The ensō is a circle brushed in a single movement by Zen monks, both as practice and as a portrait of the mind at that moment.", "haiku": ["名月や池をめぐりて夜もすがら", "meigetsu ya / ike o megurite / yomosugara", "Harvest moon: I walk round and round the pond all night long.", "Bashō"]},
	{"kanji": "硯", "name": "Ink Stone", "from": 190, "note": "Brush, ink, paper and inkstone are the Four Treasures of the Study. Ink is a solid stick, ground with water on the stone before each sitting, and the grinding itself was held to settle the mind.", "haiku": ["硯かと拾ふやくぼき石の露", "suzuri ka to / hirou ya kuboki / ishi no tsuyu", "An inkstone? I pick it up: dew in the hollow of a stone.", "Bashō"]},
	{"kanji": "無刀", "name": "No Sword", "from": 208, "note": "Mutō, no sword, was the pride of the Yagyū Shinkage school: disarming a swordsman with bare hands. Yagyū Muneyoshi showed it to Tokugawa Ieyasu in 1594, and his family became sword teachers to the shoguns.", "haiku": ["むざんやな甲の下のきりぎりす", "muzan ya na / kabuto no shita no / kirigirisu", "How pitiful: beneath the helmet, a cricket chirps.", "Bashō"]},
	{"kanji": "達磨", "name": "Daruma", "from": 226, "note": "Daruma dolls are modelled on Bodhidharma, who carried Zen from India to China and is said to have sat facing a wall for nine years. Weighted to right themselves, they are sold without eyes: one is painted in when a wish is made, the other when it comes true.", "haiku": ["物いへば唇寒し秋の風", "mono ieba / kuchibiru samushi / aki no kaze", "When I speak, my lips feel cold: the autumn wind.", "Bashō"]},
	{"kanji": "狸", "name": "Tanuki", "from": 244, "note": "The tanuki, or raccoon dog, is a real animal and a famous shapeshifter of folklore, changing form with a leaf on its head. In the tale Bunbuku Chagama one turns itself into a tea kettle at the temple Morin-ji.", "haiku": ["戸を叩く狸と秋を惜しみけり", "to o tataku / tanuki to aki o / oshimikeri", "With the tanuki knocking at my door, I mourned the passing of autumn.", "Buson"]},
	{"kanji": "赤い糸", "name": "Red Thread", "from": 262, "note": "Hitodama are pale balls of fire said to be souls leaving the body. The red thread of fate, a belief shared across East Asia, joins two people who are destined to meet.", "haiku": ["荒海や佐渡によこたふ天の河", "araumi ya / Sado ni yokotau / amanogawa", "A rough sea: stretching out over Sado, the River of Heaven.", "Bashō"]},
	{"kanji": "風", "name": "Wind", "from": 280, "note": "Storms wrecked the Mongol invasion fleets of 1274 and 1281 off Kyushu, the second a great typhoon. The storms were named kamikaze, the divine wind.", "haiku": ["吹き飛ばす石は浅間の野分かな", "fukitobasu / ishi wa Asama no / nowaki kana", "Stones are sent flying: the autumn gale on Mount Asama.", "Bashō"]},
	{"kanji": "雨", "name": "Rain", "from": 298, "note": "Tsuyu, the plum rains, soak Japan for about six weeks each early summer. Rivers rise, and in the old stories the kappa rise with them.", "haiku": ["五月雨をあつめて早し最上川", "samidare o / atsumete hayashi / Mogamigawa", "Gathering the early-summer rains, how swiftly it runs: the Mogami River.", "Bashō"]},
	{"kanji": "雪", "name": "Deep Snow", "from": 316, "note": "The snow country on the Japan Sea side of the mountains can lie under several metres each winter. The poet Issa, who was born and died in its Shinano highlands, wrote: so this is my last home? Five feet of snow.", "haiku": ["いざさらば雪見にころぶ所まで", "iza saraba / yukimi ni korobu / tokoro made", "Well then, let us go snow-viewing, until we tumble over.", "Bashō"]},
	{"kanji": "夜", "name": "Night", "from": 334, "note": "Before electric light, travellers carried paper lanterns painted with their house crest. In the game Hyakumonogatari a hundred ghost stories were told through the night, and one light put out after each.", "haiku": ["名月を取ってくれろと泣く子かな", "meigetsu o / totte kurero to / naku ko kana", "\"Get me that harvest moon!\" cries the child.", "Issa"]},
	{"kanji": "死神", "name": "Shinigami", "from": 352, "note": "The shinigami, a spirit that draws people toward death, appears in Edo-period puppet plays about lovers' suicides and in the 1841 picture book Ehon Hyaku Monogatari.", "haiku": ["やれ打つな蝿が手をすり足をする", "yare utsu na / hae ga te o suri / ashi o suru", "Oh, don't swat it! The fly rubs its hands, rubs its feet.", "Issa"]},
	{"kanji": "式神", "name": "Shikigami", "from": 370, "note": "Onmyōdō, the Way of Yin and Yang, was the court science of divination and protection in Heian Japan. Its most famous master, Abe no Seimei (921–1005), is said to have commanded twelve shikigami.", "haiku": ["旅に病んで夢は枯野をかけ廻る", "tabi ni yande / yume wa kareno o / kakemeguru", "Fallen ill on a journey, my dreams go roaming over withered fields.", "Bashō"]},
	{"kanji": "供物", "name": "Offerings", "from": 388, "note": "Food and drink set before gods, buddhas and the dead are called kumotsu. In the old tales help and harm alike are bought with food: kappa with cucumbers, the oni king Shuten-dōji undone by drugged sake, and Momotarō's three companions with millet dumplings.", "haiku": ["我と来て遊べや親のない雀", "ware to kite / asobe ya oya no / nai suzume", "Come and play with me, sparrow without parents.", "Issa"]},
	{"kanji": "梵鐘", "name": "Temple Bell", "from": 406, "note": "Bonshō, the great bronze bells of Buddhist temples, have no clapper: they are struck from outside with a hanging beam. On New Year's Eve they are rung 108 times, once for each of the worldly desires.", "haiku": ["柿くへば鐘が鳴るなり法隆寺", "kaki kueba / kane ga naru nari / Hōryūji", "As I eat a persimmon, the bell tolls: Hōryū-ji.", "Shiki"]},
	{"kanji": "橋", "name": "The Bridge", "from": 424, "note": "In 1180 Minamoto no Yorimasa and the warrior monks of Mii-dera tore up the planks of the bridge at Uji to hold back the Taira army. The Tale of the Heike tells how the monks fought on along the bare beams.", "haiku": ["桟やいのちをからむつたかづら", "kakehashi ya / inochi o karamu / tsutakazura", "The hanging bridge: ivy vines twine around it, clinging for dear life.", "Bashō"]},
	{"kanji": "蜘蛛", "name": "The Spider", "from": 442, "note": "The jorōgumo is a spider grown old enough to take the shape of a woman. At Jōren Falls in Izu one is said to have thrown her thread around a resting woodcutter's foot. He looped it over a stump instead, and the stump was dragged under the water.", "haiku": ["隅の蜘案じな煤はとらぬぞよ", "sumi no kumo / anjina susu wa / toranu zo yo", "Spider in the corner, don't worry: I won't be sweeping away the soot.", "Issa"]},
	{"kanji": "鎌鼬", "name": "Kamaitachi", "from": 460, "note": "Kamaitachi, the sickle weasel, rides the whirlwinds of the snowy northern provinces and leaves clean cuts that do not bleed. In Hida they say there are three: one knocks you down, one cuts, and one puts on the salve.", "haiku": ["木枯に岩吹きとがる杉間かな", "kogarashi ni / iwa fukitogaru / sugima kana", "In the withering wind the rocks are blown sharp, there between the cedars.", "Bashō"]},
	{"kanji": "封印", "name": "The Seals", "from": 478, "note": "An ofuda is a paper seal from a shrine or temple, and what it is pasted on stays bound until it is lifted. Much of Japanese practice is a matter of order: at a shrine, two bows, two claps, one bow, and never the other way about.", "haiku": ["鶏頭の十四五本もありぬべし", "keitō no / jūshigohon mo / arinubeshi", "Cockscombs: there must be fourteen or fifteen of them.", "Shiki"]},
	{"kanji": "誘い", "name": "The Lure", "from": 496, "note": "Small wayside shrines and stone Jizō stand at bridges and crossroads all over Japan, and passers-by leave them rice cakes, coins and cups of sake. Jizō is the guardian of travellers and of children.", "haiku": ["芭蕉野分して盥に雨を聞く夜かな", "bashō nowaki shite / tarai ni ame o / kiku yo kana", "A gale in the banana plant; a night spent listening to rain drip into a basin.", "Bashō"]},
	{"kanji": "嵐", "name": "The Storm", "from": 514, "note": "Nowaki, the field-parting wind, is the old name for the typhoons of early autumn. A chapter of The Tale of Genji is named for one, and Bashō wrote of his banana tree thrashing in such a storm while he listened to rain dripping into a basin all night.", "haiku": ["世の中は地獄の上の花見かな", "yo no naka wa / jigoku no ue no / hanami kana", "In this world, we view the blossoms on the roof of hell.", "Issa"]},
	{"kanji": "結び", "name": "The Knot", "from": 532, "note": "Knots carry meaning in Japan: the mizuhiki cords tied on gifts, the shimenawa rope that marks sacred ground, the cord of a shrine charm. Musubi, tying, is also an old word for the power that brings things into being.", "haiku": ["蛤のふたみにわかれ行く秋ぞ", "hamaguri no / futami ni wakare / yuku aki zo", "Like a clam torn into shell and flesh, I part for Futami as autumn goes.", "Bashō"]},
	{"kanji": "書", "name": "The Character", "from": 550, "note": "Shodō, the way of writing, came to Japan from China with the characters themselves. Kūkai, Emperor Saga and Tachibana no Hayanari are remembered as the Three Brushes. Children still write their first characters of the year on the second of January.", "haiku": ["蛸壺やはかなき夢を夏の月", "takotsubo ya / hakanaki yume o / natsu no tsuki", "Octopus pots: fleeting dreams beneath the summer moon.", "Bashō"]},
	{"kanji": "筆", "name": "The Brush", "from": 568, "note": "A writing brush, fude, is animal hair bound into a shaft of bamboo. Worn-out brushes are not simply thrown away: at fude-kuyō services, held at temples and shrines, they are thanked and burned.", "haiku": ["物書て扇引さく余波哉", "mono kakite / ōgi hikisaku / nagori kana", "I write something on the fan and tear it in two: the sorrow of parting.", "Bashō"]},
]
